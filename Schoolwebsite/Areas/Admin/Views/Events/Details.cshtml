@using Schoolwebsite.Models
@using Schoolwebsite.Helpers
@model SchoolEvent
@{
    ViewData["Title"] = "Event Details";
}

<div class="admin-card">

    <!-- Header -->
    <div class="d-flex align-items-center flex-wrap mb-4 pb-4" style="border-bottom:1px solid #eee;">
        <img src="@(string.IsNullOrEmpty(Model.ImagePath) ? "/images/no-photo.png" : Model.ImagePath)"
             style="width:110px;height:110px;object-fit:cover;border-radius:8px;border:3px solid #fff;box-shadow:0 0 0 1px #e9ecef;"
             class="mr-4"
             alt="@Model.Title">

        <div class="ml-3">
            <h4 class="mb-2">@Model.Title</h4>
            <div>
                <span class="badge badge-primary" style="font-weight:500;">
                    <i class="fa fa-calendar mr-1"></i>@Model.Date.ToString("dd MMM yyyy")
                </span>
                <span class="badge badge-secondary" style="font-weight:500;">
                    <i class="fa fa-clock-o mr-1"></i>@Model.StartTime - @Model.EndTime
                </span>
                <span class="badge badge-light border" style="font-weight:500;">
                    <i class="fa fa-map-marker mr-1"></i>@Model.Location
                </span>
            </div>
        </div>
    </div>

    <!-- Summary -->
    <div class="mb-4">
        <h6 class="text-uppercase text-muted" style="font-size:12px;letter-spacing:.5px;">Summary</h6>
        <p class="mb-0">@Model.Summary</p>
    </div>

    <!-- Body -->
    <div class="mb-4">
        <h6 class="text-uppercase text-muted" style="font-size:12px;letter-spacing:.5px;">Details</h6>
        @foreach (var line in Model.Body.ToLines())
        {
            <p>@line</p>
        }
    </div>

    <!-- Actions -->
    <div class="pt-3" style="border-top:1px solid #eee;">
        <a asp-action="Edit" asp-route-id="@Model.SchoolEventId" class="btn btn-primary btn-sm">
            <i class="fa fa-pencil mr-1"></i> Edit
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="fa fa-arrow-left mr-1"></i> Back to List
        </a>
    </div>
</div>



