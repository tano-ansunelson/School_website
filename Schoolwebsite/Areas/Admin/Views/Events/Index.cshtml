@using Schoolwebsite.Models
@model List<SchoolEvent>
@{
    ViewData["Title"] = "Events";
}

<div class="d-flex justify-content-between align-items-center mb-15">
    <p class="text-muted mb-0"><strong>@Model.Count</strong> event@(Model.Count==1? "":"s")</p>
    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fa fa-plus mr-1"></i> Add Event</a>
</div>

<div class="admin-card p-0">
    <table class="table admin-table mb-0 align-middle">
        <thead>
            <tr>
                <th style="width:70px;"></th>
                <th>Title</th>
                <th>Date</th>
                <th>Location</th>
                <th class="text-right" style="width:160px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ev in Model.OrderBy(e => e.Date))
            {
                <tr>
                    <td><img src="@ev.ImagePath" class="thumb" alt="@ev.Title"></td>
                    <td>@ev.Title</td>
                    <td>@ev.Date.ToString("dd MMM yyyy")</td>
                    <td>@ev.Location</td>
                    <td class="text-right">
                        @* <a asp-action="Details" asp-route-id="@ev.SchoolEventId" class="btn btn-sm btn-outline-secondary">View</a> *@
                        <a asp-action="Details" asp-route-id="@ev.SchoolEventId"
                           class="btn btn-sm btn-outline-secondary" title="View">
                            <i class="fa fa-eye"></i>
                        </a>
                        <a asp-action="Edit" asp-route-id="@ev.SchoolEventId"
                           class="btn btn-sm btn-outline-secondary" title="Edit">
                            <i class="fa fa-pencil"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@ev.SchoolEventId"
                           class="btn btn-sm btn-outline-danger" title="Delete"
                          >
                            <i class="fa fa-trash"></i>
                        </a>
                    </td>
                </tr>
            }
           @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted pt-30 pb-30">
                        <i class="fa fa-user-o mb-2" style="font-size:28px;display:block;color:#ccc;"></i>
                        No events yet.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
