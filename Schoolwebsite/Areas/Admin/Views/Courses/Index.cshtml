@using Schoolwebsite.Models
@model List<Course>
@{
    ViewData["Title"] = "Courses";
}

<div class="d-flex justify-content-between align-items-center mb-15">
    <p class="text-muted mb-0">@Model.Count programme(s)</p>
    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fa fa-plus"></i> Add Programme</a>
</div>

<div class="admin-card p-0">
    <table class="table admin-table mb-0">
        <thead>
            <tr>
                <th></th>
                <th>Title</th>
                <th>Durations</th>
               @*  <th>Coordinator</th> *@
                <th class="text-right">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var course in Model)
            {
                <tr>
                    <td><img src="@course.ImagePath" class="thumb" alt="@course.Title"></td>
                    <td>@course.Title</td>
                    <td>@course.Duration</td>
                    @* <td>@(  "—")</td> *@
                    <td class="text-right">
                        <a asp-action="Details" asp-route-id="@course.CourseId" class="btn btn-sm btn-outline-secondary">View</a>
                        <a asp-action="Edit" asp-route-id="@course.CourseId" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@course.CourseId" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="5" class="text-center text-muted pt-30 pb-30">No programmes yet.</td></tr>
            }
        </tbody>
    </table>
</div>
