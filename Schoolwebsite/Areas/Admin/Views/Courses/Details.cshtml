@using Schoolwebsite.Models
@using Schoolwebsite.Helpers
@model Course
@{
    ViewData["Title"] = "Programme Details";
}

<div class="admin-card">

    <!-- Header -->
    <div class="d-flex align-items-center flex-wrap mb-4 pb-4" style="border-bottom:1px solid #eee;">
        <img src="@(string.IsNullOrEmpty(Model.ImagePath) ? "/images/no-photo.png" : Model.ImagePath)"
             style="width:110px;height:110px;object-fit:cover;border-radius:8px;border:3px solid #fff;box-shadow:0 0 0 1px #e9ecef;"
             class="mr-4"
             alt="@Model.Title">

        <div class="ml-3">
            <h4 class="mb-2">@Model.Title</h4>
            <div>
              @*   <span class="badge badge-primary" style="font-weight:500;">
                    <i class="fa fa-folder-o mr-1"></i>@Model.Category
                </span> *@
                <span class="badge badge-secondary" style="font-weight:500;">
                    <i class="fa fa-clock-o mr-1"></i>@Model.Duration
                </span>
            </div>
        </div>
    </div>

    <!-- Overview -->
    <div class="mb-4">
        <h6 class="text-uppercase text-muted" style="font-size:12px;letter-spacing:.5px;">Overview</h6>
        @foreach (var line in Model.Overview.ToLines())
        {
            <p>@line</p>
        }
    </div>

    <!-- Subjects -->
    <div class="row mb-4">
        <div class="col-md-6">
            <h6 class="text-uppercase text-muted" style="font-size:12px;letter-spacing:.5px;">Core Subjects</h6>
            <ul class="pl-3 mb-0">
                @foreach (var s in Model.CoreSubjects.ToLines())
                {
                    <li>@s</li>
                }
            </ul>
        </div>
        <div class="col-md-6">
            <h6 class="text-uppercase text-muted" style="font-size:12px;letter-spacing:.5px;">Elective Subjects</h6>
            <ul class="pl-3 mb-0">
                @foreach (var s in Model.ElectiveSubjects.ToLines())
                {
                    <li>@s</li>
                }
            </ul>
        </div>
    </div>

    <!-- Entry Requirements -->
    <div class="mb-4">
        <h6 class="text-uppercase text-muted" style="font-size:12px;letter-spacing:.5px;">Entry Requirements</h6>
        <ul class="pl-3 mb-0">
            @foreach (var r in Model.EntryRequirements.ToLines())
            {
                <li>@r</li>
            }
        </ul>
    </div>

    <!-- Actions -->
    <div class="pt-3" style="border-top:1px solid #eee;">
        <a asp-action="Edit" asp-route-id="@Model.CourseId" class="btn btn-primary btn-sm">
            <i class="fa fa-pencil mr-1"></i> Edit
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="fa fa-arrow-left mr-1"></i> Back to List
        </a>
    </div>
</div>




