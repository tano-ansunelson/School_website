@{
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    Func<string, string> navActive = (controller) => currentController == controller ? "active" : "";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - Admin</title>
    <link rel="stylesheet" href="~/css/bootstrap.min.css">
   @*  <link rel="stylesheet" href="~/css/font-awesome.min.css"> *@
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="~/css/default.css">
    <link rel="stylesheet" href="~/css/admin.css">
</head>
<body class="admin-body">

    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-2 col-md-3 px-0 admin-sidebar">
                <a class="brand" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                    <i class="fa fa-graduation-cap"></i> School Admin
                </a>
                <nav class="nav flex-column">
                    <a class="nav-link @navActive("Dashboard")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                        <i class="fa fa-th-large mr-10"></i> Dashboard
                    </a>
                    <a class="nav-link @navActive("Teachers")" asp-area="Admin" asp-controller="Teachers" asp-action="Index">
                        <i class="fa fa-users mr-10"></i> Teachers
                    </a>
                    <a class="nav-link @navActive("Courses")" asp-area="Admin" asp-controller="Courses" asp-action="Index">
                        <i class="fa fa-book mr-10"></i> Courses
                    </a>
                    <a class="nav-link @navActive("Student")" asp-area="Admin" asp-controller="Student" asp-action="Index">
                        <i class="fa fa-book mr-10"></i> Students
                    </a>
                    <a class="nav-link @navActive("Events")" asp-area="Admin" asp-controller="Events" asp-action="Index">
                        <i class="fa fa-calendar mr-10"></i> Events
                    </a>
                    <a class="nav-link @navActive("BlogPosts")" asp-area="Admin" asp-controller="BlogPosts" asp-action="Index">
                        <i class="fa fa-newspaper-o mr-10"></i> Blog Posts
                    </a>

                    <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index" target="_blank">
                        <i class="fa fa-external-link mr-10"></i> View Site
                    </a>
                </nav>
            </div>

            <div class="col-lg-10 col-md-9 px-0">
                <div class="admin-topbar d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">@ViewData["Title"]</h5>
                    <form asp-area="Admin" asp-controller="Account" asp-action="Logout" method="post" class="mb-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-secondary">
                            <i class="fa fa-sign-out"></i> Logout (@User.Identity?.Name)
                        </button>
                    </form>
                </div>

                <div class="admin-content">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">@TempData["Success"]</div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">@TempData["Error"]</div>
                    }

                    @RenderBody()
                </div>
            </div>
        </div>
    </div>

    <script src="~/js/vendor/jquery-1.12.4.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.2/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
