@using Schoolwebsite.Models
@model List<Student>
@{
    ViewData["Title"] = "Student";
}

<div class="d-flex justify-content-between align-items-center mb-15">
    <p class="text-muted mb-0">@Model.Count student(s)</p>
    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fa fa-plus"></i> Add Student</a>
</div>

<div class="admin-card p-0">
    <table class="table admin-table mb-0">
        <thead>
            <tr>
                <th></th>
                <th>Name</th>
                <th>Role</th>

                <th class="text-right">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var student in Model)
            {
                <tr>
                    <td><img src="@student.ImagePath" class="thumb" alt="@student.Name"></td>
                    <td>@student.Name</td>
                    <td>@student.Role</td>
                    @* <td>@teacher.Subject</td> *@
                    <td class="text-right">
                       @*  <a asp-action="Details" asp-route-id="@student.StudentId" class="btn btn-sm btn-outline-secondary">View</a> *@
                        <a asp-action="Edit" asp-route-id="@student.StudentId" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@student.StudentId" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="5" class="text-center text-muted pt-30 pb-30">No student yet.</td></tr>
            }
        </tbody>
    </table>
</div>


