@using Schoolwebsite.Models
@model Student
@{
    ViewData["Title"] = "Delete Student";
}

<div class="admin-card">
    <p>Are you sure you want to delete <strong>@Model.Name</strong>? This can't be undone.</p>
    @* 
    @if (Model.CoordinatedCourses.Any())
    {
        <div class="alert alert-warning">
            This teacher coordinates @Model.CoordinatedCourses.Count programme(s). You'll need to reassign or delete those first.
        </div>
    } *@

    <div class="d-flex align-items-center mb-20">
        <img src="@Model.ImagePath" style="width:80px;height:80px;object-fit:cover;border-radius:4px;" class="mr-15">
        <div>
            <strong>@Model.Name</strong><br>
            <span class="text-muted">@Model.Role</span>
        </div>
    </div>

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="StudentId" />
        <button type="submit" class="btn btn-danger">Yes, Delete</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>
