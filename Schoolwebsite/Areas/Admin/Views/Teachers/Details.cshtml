@using Schoolwebsite.Models
@model Teacher
@{
    ViewData["Title"] = "Teacher Details";
}

<div class="admin-card">

    <!-- Profile Header -->
    <div class="d-flex align-items-center flex-wrap mb-4 pb-4" style="border-bottom:1px solid #eee;">
        <img src="@(string.IsNullOrEmpty(Model.ImagePath) ? "/images/no-photo.png" : Model.ImagePath)"
             style="width:110px;height:110px;object-fit:cover;border-radius:50%;border:3px solid #fff;box-shadow:0 0 0 1px #e9ecef;"
             class="mr-4"
             alt="@Model.Name">

        <div class="ml-3">
            <h4 class="mb-1">@Model.Name</h4>
            <div class="mb-2">
                <span class="badge badge-primary" style="font-weight:500;">@Model.Role</span>
                <span class="badge badge-secondary" style="font-weight:500;">@Model.Subject</span>
            </div>

            <div>
                @if (!string.IsNullOrEmpty(Model.FacebookUrl))
                {
                    <a href="@Model.FacebookUrl" target="_blank" class="text-muted mr-2" title="Facebook">
                        <i class="fa fa-facebook-square" style="font-size:18px;"></i>
                    </a>
                }
                @if (!string.IsNullOrEmpty(Model.TwitterUrl))
                {
                    <a href="@Model.TwitterUrl" target="_blank" class="text-muted mr-2" title="Twitter">
                        <i class="fa fa-twitter-square" style="font-size:18px;"></i>
                    </a>
                }
                @if (!string.IsNullOrEmpty(Model.LinkedInUrl))
                {
                    <a href="@Model.LinkedInUrl" target="_blank" class="text-muted" title="LinkedIn">
                        <i class="fa fa-linkedin-square" style="font-size:18px;"></i>
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- Details -->
    <div class="mb-4">
        <h6 class="text-uppercase text-muted" style="font-size:12px;letter-spacing:.5px;">About</h6>
        <p class="mb-0">@Model.About</p>
    </div>

    <div class="row mb-4">
        <div class="col-md-6">
            <h6 class="text-uppercase text-muted" style="font-size:12px;letter-spacing:.5px;">Achievements</h6>
            <p class="mb-0">@(string.IsNullOrEmpty(Model.Achievements) ? "—" : Model.Achievements)</p>
        </div>
        <div class="col-md-6">
            <h6 class="text-uppercase text-muted" style="font-size:12px;letter-spacing:.5px;">Objective</h6>
            <p class="mb-0">@(string.IsNullOrEmpty(Model.Objective) ? "—" : Model.Objective)</p>
        </div>
    </div>

    <!-- Actions -->
    <div class="pt-3" style="border-top:1px solid #eee;">
        <a asp-action="Edit" asp-route-id="@Model.TeacherId" class="btn btn-primary btn-sm">
            <i class="fa fa-pencil mr-1"></i> Edit
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="fa fa-arrow-left mr-1"></i> Back to List
        </a>
    </div>
</div>

