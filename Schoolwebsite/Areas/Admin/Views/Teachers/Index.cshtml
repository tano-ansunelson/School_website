@using Schoolwebsite.Models
@model List<Teacher>
@{
    ViewData["Title"] = "Teachers";
}

<div class="d-flex justify-content-between align-items-center mb-15">
    <p class="text-muted mb-0"><strong>@Model.Count</strong> teacher@(Model.Count == 1 ? "" : "s")</p>
    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fa fa-plus mr-1"></i> Add Teacher</a>
</div>

<div class="admin-card p-0">
    <table class="table admin-table mb-0 align-middle">
        <thead>
            <tr>
                <th style="width:70px;"></th>
                <th>Name</th>
                <th>Role</th>
                <th>Subject</th>
                <th class="text-right" style="width:160px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var teacher in Model)
            {
                <tr>
                    <td>
                        <img src="@(string.IsNullOrEmpty(teacher.ImagePath) ? "/images/no-photo.png" : teacher.ImagePath)"
                             class="thumb"
                             style="width:44px;height:44px;object-fit:cover;border-radius:50%;"
                             alt="@teacher.Name">
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@teacher.TeacherId" class="font-weight-bold text-dark">
                            @teacher.Name
                        </a>
                    </td>
                    <td>
                        <span class="badge badge-light border" style="font-weight:500;">@teacher.Role</span>
                    </td>
                    <td class="text-muted">@teacher.Subject</td>
                    <td class="text-right">
                        <a asp-action="Details" asp-route-id="@teacher.TeacherId"
                           class="btn btn-sm btn-outline-secondary" title="View">
                            <i class="fa fa-eye"></i>
                        </a>
                        <a asp-action="Edit" asp-route-id="@teacher.TeacherId"
                           class="btn btn-sm btn-outline-secondary" title="Edit">
                            <i class="fa fa-pencil"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@teacher.TeacherId"
                           class="btn btn-sm btn-outline-danger" title="Delete"
                           onclick="return confirm('Delete @teacher.Name? This cannot be undone.');">
                            <i class="fa fa-trash"></i>
                        </a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted pt-30 pb-30">
                        <i class="fa fa-user-o mb-2" style="font-size:28px;display:block;color:#ccc;"></i>
                        No teachers yet.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>



