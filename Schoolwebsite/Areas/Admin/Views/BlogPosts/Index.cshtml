@model List<BlogPost> 
@{
    ViewData["Title"] = "Blog Posts";
}

<div class="d-flex justify-content-between align-items-center mb-15">
    <p class="text-muted mb-0">@Model.Count post(s)</p>
    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fa fa-plus"></i> Add Post</a>
</div>

<div class="admin-card p-0">
    <table class="table admin-table mb-0">
        <thead>
            <tr>
                <th></th>
                <th>Title</th>
                <th>Author</th>
                <th>Date</th>
                <th class="text-right">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var post in Model.OrderByDescending(p => p.Date ))
            {
                <tr>
                    <td><img src="@post.ImagePath" class="thumb" alt="@post.Title"></td>
                    <td>@post.Title</td>
                    <td>@post.Author</td>
                    <td>@post.Date.ToString("dd MMM yyyy")</td>
                    <td class="text-right">
                        <a asp-action="Details" asp-route-id="@post.BlogPostId" class="btn btn-sm btn-outline-secondary">View</a>
                        <a asp-action="Edit" asp-route-id="@post.BlogPostId" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@post.BlogPostId" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="5" class="text-center text-muted pt-30 pb-30">No blog posts yet.</td></tr>
            }
        </tbody>
    </table>
</div>
