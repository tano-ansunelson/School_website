<!--====== COURSE PART START ======-->

<section id="course-part" class="pt-65 pb-90 gray-bg">
    <div class="container">
        <div class="row">
            <div class="col-lg-6">
                <div class="section-title pb-45">
                    <h5>What we offer</h5>
                    <h2>Our Academic Programmes</h2>
                </div> <!-- section title -->
            </div>
        </div> <!-- row -->
        <div class="row mt-30">
            @if (courses != null)
            {
                @foreach (var course in courses)
                {
                    <div class="col-lg-4 col-md-6">
                        <div class="singel-course mt-30">
                            <div class="thum">
                                <div class="image">
                                    <img src="@course.ImagePath" alt="@course.Title">
                                </div>
                                <div class="price">
                                    <span>@course.Duration</span>
                                </div>
                            </div>
                            <div class="cont">
                               @*  <span>@course.Category</span> *@
                                <a asp-controller="Courses" asp-action="Details" asp-route-id="@course.CourseId"><h4>@course.Title</h4></a>
                            </div>
                        </div> <!-- singel course -->
                    </div>
                }
            }
        </div> <!-- row -->
        <div class="row">
            <div class="col-lg-12 text-center mt-20">
                <a asp-controller="Courses" asp-action="Index" class="main-btn">View All Programmes</a>
            </div>
        </div>
    </div> <!-- container -->
</section>

<!--====== COURSE PART ENDS ======-->



