<!--====== TEACHERS PART START ======-->

<section id="teachers-part" class="pt-70 pb-90 gray-bg">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-5">
                <div class="section-title mt-50 pb-15">
                    <h5>Featured Teachers</h5>
                    <h2>Meet Our Teachers</h2>
                </div> <!-- section title -->
                <div class="about-cont">
                    <p>
                        @school.Name brings together experienced, dedicated teachers across every
                        department — from the sciences to the arts — committed to helping each
                        student reach their full potential.
                    </p>
                </div>
                <a asp-controller="Teachers" asp-action="Index" class="main-btn mt-30">Meet the Team</a>
            </div> <!-- about cont -->
            <div class="col-lg-7">
                <div class="row">
                    @if (teachers != null)
                    {
                        @foreach (var teacher in teachers)
                        {
                            <div class="col-6 mb-30">
                                <div style="position:relative; overflow:hidden; border-radius:4px;">
                                    <img src="@teacher.ImagePath" alt="@teacher.Name"
                                         style="width:100%; height:280px; object-fit:cover; display:block;">
                                    <div style="position:absolute; left:20px; bottom:20px; right:20px; background:#fff; padding:15px 20px; border-radius:2px; box-shadow:0 5px 15px rgba(0,0,0,0.1);">
                                        <a asp-controller="Teachers" asp-action="Details" asp-route-id="@teacher.TeacherId" style="text-decoration:none; color:#222;">
                                            <h6 style="margin-bottom:2px;">@teacher.Name</h6>
                                        </a>
                                        <span style="color:#777; font-size:14px;">@teacher.Role</span>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div> <!-- row -->
            </div>
        </div> <!-- row -->
    </div> <!-- container -->
</section>

<!--====== TEACHERS PART ENDS ======-->
<!--====== TEACHERS PART ENDS ======-->
<!--====== NEWS PART START ======-->

<section id="news-part" class="pt-115 pb-110">
    <div class="container">
        <div class="row">
            <div class="col-lg-5">
                <div class="section-title mt-50 pb-35">
                    <h5>Our Blog</h5>
                    <h2>Latest News</h2>
                </div> <!-- section title -->
            </div>
        </div> <!-- row -->
        <div class="row">
            @if (latestPosts != null)
            {
                @foreach (var post in latestPosts)
                {
                    <div class="col-lg-4 col-md-6">
                        <div class="singel-news mt-30">
                            <div class="news-thum">
                                <img src="@post.ImagePath" alt="@post.Title">
                            </div>
                            <div class="news-cont">
                                <ul>
                                    <li><a href="#"><i class="fa fa-calendar"></i>@post.Date.ToString("dd MMM yyyy")</a></li>
                                    <li><a href="#"><i class="fa fa-tags"></i>@post.Category</a></li>
                                </ul>
                                <a asp-controller="Blog" asp-action="Details" asp-route-id="@post.BlogPostId"><h5>@post.Title</h5></a>
                            </div>
                        </div> <!-- singel news -->
                    </div>
                }
            }
        </div> <!-- row -->
    </div> <!-- container -->
</section>

<!--====== NEWS PART ENDS ======-->
