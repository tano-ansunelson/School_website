@using Schoolwebsite
@using Microsoft.Extensions.Options
@inject IOptions<SchoolInfo> SchoolInfoOptions
@{
    ViewData["Title"] = "Home";
    var school = SchoolInfoOptions.Value;
    var latestPosts = ViewBag.LatestPosts as List<BlogPost>;
    var teachers = ViewBag.FeaturedTeachers as List<Teacher>;
    var courses = ViewBag.FeaturedCourses as List<Course>;
    var events = ViewBag.UpcomingEvents as List<SchoolEvent>;
}

<!--====== HERO / BANNER PART START ======-->

<section id="hero-part" class="bg_cover pt-150 pb-150" data-overlay="6" style="background-image: url(@Url.Content("~/images/slider/s-1.jpg"))">
    <div class="container">
        <div class="row">
            <div class="col-xl-8 col-lg-9">
                <div class="slider-cont">
                    <h1>@school.Name</h1>
                    <p>@school.Tagline Building a strong foundation in academics, character and leadership for every student who walks through our gates.</p>
                    <ul>
                        <li><a class="main-btn" asp-controller="Home" asp-action="About">Learn More</a></li>
                        <li><a class="main-btn main-btn-2" asp-controller="Home" asp-action="Contact">Apply Now</a></li>
                    </ul>
                </div>
            </div>
        </div> <!-- row -->
    </div> <!-- container -->
</section>

<!--====== HERO / BANNER PART ENDS ======-->
<!--====== ABOUT PART START ======-->

<section id="about-part" class="pt-65 pb-65">
    <div class="container">
        <div class="row">
            <div class="col-lg-5">
                <div class="section-title mt-50">
                    <h5>About us</h5>
                    <h2>Welcome to @school.ShortName</h2>
                </div> <!-- section title -->
                <div class="about-cont">
                    <p>
                        @school.Name is dedicated to providing quality secondary education that prepares
                        students for WASSCE success and life beyond the classroom. Our dedicated teachers
                        and modern facilities give every student the support they need to thrive.
                    </p>
                    <a asp-controller="Home" asp-action="About" class="main-btn mt-30">Learn More</a>
                </div>
            </div> <!-- about cont -->
            <div class="col-lg-6 offset-lg-1">
                <div class="about-event bg_cover mt-50" style="background-image: url(@Url.Content("~/images/images.jpg"))">
                    <div class="event-title">
                        <h3>Upcoming events</h3>
                    </div> <!-- event title -->
                    @if (events != null)
                    {
                        @foreach (var ev in events)
                        {
                            <div class="singel-event-list">
                                <div class="event-cont">
                                    <span><i class="fa fa-calendar"></i>@ev.Date.ToString("dd MMMM yyyy")</span>
                                    <a asp-controller="Events" asp-action="Details" asp-route-id="@ev.SchoolEventId"><h4>@ev.Title</h4></a>
                                    <span><i class="fa fa-clock-o"></i>@ev.StartTime - @ev.EndTime</span>
                                    <span><i class="fa fa-map-marker"></i>@ev.Location</span>
                                </div>
                            </div> <!-- singel event list -->
                        }
                    }
                </div> <!-- about event -->
            </div>
        </div> <!-- row -->
    </div> <!-- container -->
</section>

<!--====== ABOUT PART ENDS ======-->
<!--====== ABOUT PART START ======-->
