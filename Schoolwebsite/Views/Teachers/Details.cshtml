@model Teacher
@{
    ViewData["Title"] = Model.Name;
}

<!--====== PAGE BANNER PART START ======-->

<section id="page-banner" class="pt-105 pb-130 bg_cover" data-overlay="8" style="background-image: url(@Url.Content("~/images/page-banner-3.jpg"))">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="page-banner-cont">
                    <h2>@Model.Name</h2>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                            <li class="breadcrumb-item"><a asp-controller="Teachers" asp-action="Index">Teachers</a></li>
                            <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
                        </ol>
                    </nav>
                </div> <!-- page banner cont -->
            </div>
        </div> <!-- row -->
    </div> <!-- container -->
</section>

<!--====== PAGE BANNER PART ENDS ======-->
<!--====== TEACHERS PART START ======-->

<section id="teachers-singel" class="pt-70 pb-120 gray-bg">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-4 col-md-8">
                <div class="teachers-left mt-50">
                    <div class="hero">
                        <img src="@Model.ImagePath" alt="@Model.Name">
                    </div>
                    <div class="name">
                        <h6>@Model.Name</h6>
                        <span>@Model.Role</span>
                    </div>
                    <div class="social">
                        <ul>
                            <li><a href="@Model.FacebookUrl"><i class="fa fa-facebook-square"></i></a></li>
                            <li><a href="@Model.TwitterUrl"><i class="fa fa-twitter-square"></i></a></li>
                            <li><a href="@Model.LinkedInUrl"><i class="fa fa-linkedin-square"></i></a></li>
                        </ul>
                    </div>
                    <div class="description">
                        <p>@Model.About</p>
                    </div>
                </div> <!-- teachers left -->
            </div>
            <div class="col-lg-8">
                <div class="teachers-right mt-50">
                    <div class="dashboard-cont">
                        <div class="singel-dashboard pt-40">
                            <h5>Subject</h5>
                            <p>@Model.Subject</p>
                        </div> <!-- singel dashboard -->
                        <div class="singel-dashboard pt-40">
                            <h5>About</h5>
                            <p>@Model.About</p>
                        </div> <!-- singel dashboard -->
                        <div class="singel-dashboard pt-40">
                            <h5>Achievements</h5>
                            <p>@Model.Achievements</p>
                        </div> <!-- singel dashboard -->
                        <div class="singel-dashboard pt-40">
                            <h5>Teaching Objective</h5>
                            <p>@Model.Objective</p>
                        </div> <!-- singel dashboard -->
                    </div> <!-- dashboard cont -->
                </div> <!-- teachers right -->
            </div>
        </div> <!-- row -->
    </div> <!-- container -->
</section>

<!--====== TEACHERS PART ENDS ======-->
