@using Schoolwebsite.Models
@model List<Student>
@{
    var categoryLabels = new Dictionary<string, string>
    {
        ["prefect"] = "Prefects",
        ["headboy"] = "Head Boy",
        ["headgirl"] = "Head Girl",
        ["classrep"] = "Class Representatives"
    };

    string? selectedCategory = ViewBag.SelectedCategory as string;
    string pageHeading = (selectedCategory != null && categoryLabels.TryGetValue(selectedCategory, out var label))
        ? label
        : "Student Representatives";

    ViewData["Title"] = pageHeading;
}

<!--====== PAGE BANNER PART START ======-->

<section id="page-banner" class="pt-105 pb-110 bg_cover" data-overlay="8" style="background-image: url(@Url.Content("~/images/page-banner-3.jpg"))">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="page-banner-cont">
                    <h2>@pageHeading</h2>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                            @if (selectedCategory != null)
                            {
                                <li class="breadcrumb-item"><a asp-controller="Students" asp-action="Index">Student Representatives</a></li>
                                <li class="breadcrumb-item active" aria-current="page">@pageHeading</li>
                            }
                            else
                            {
                                <li class="breadcrumb-item active" aria-current="page">Student Representatives</li>
                            }
                        </ol>
                    </nav>
                </div>  <!-- page banner cont -->
            </div>
        </div> <!-- row -->
    </div> <!-- container -->
</section>

<!--====== PAGE BANNER PART ENDS ======-->
<!--====== STUDENTS PART START ======-->
<section id="students-page" class="pt-90 pb-120 gray-bg">
    <div class="container">
        <div class="row">
            @if (!Model.Any())
            {
                <div class="col-lg-12 text-center pt-30 pb-30">
                    <p class="text-muted">No @pageHeading.ToLower() found yet.</p>
                </div>
            }
            @foreach (var student in Model)
            {
                <div class="col-lg-3 col-sm-6">
                    <div class="singel-teachers mt-30 text-center">
                        <div class="image">
                            <img src="@student.ImagePath" alt="@student.Name">
                        </div>
                        <div class="cont">
                            <h6>@student.Name</h6>
                            <span>@student.Role</span>
                        </div>
                    </div> <!-- singel teachers -->
                </div>
            }
        </div> <!-- row -->
    </div> <!-- container -->
</section>

<!--====== STUDENTS PART ENDS ======-->